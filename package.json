{
  "name": "buddy",
  "private": true,
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "check:generated": "sh scripts/check-generated.sh",
    "check:screens": "node scripts/check-screens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "node scripts/check-raw-values.mjs && node scripts/check-utilities.mjs",
    "build:tokens": "node scripts/build-static-tokens.mjs --out docs/screens/_common/tokens.css ./packages/ui/src/tokens/primitive.css ./packages/ui/src/tokens/semantic.css",
    "lint:openapi": "redocly lint",
    "generate:db-docs": "sh scripts/build-db-docs.sh",
    "build:erd": "node scripts/build-erd.mjs",
    "e2e": "pnpm --filter @buddy/e2e test",
    "site:build": "node scripts/build-docs-site.mjs --out apps/docs-site/public --build && pnpm --filter @buddy/docs-site build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@liam-hq/cli": "0.7.24",
    "@redocly/cli": "2.71.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "lefthook": "^2.2.2",
    "textlint": "^15.8.0",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-preset-ai-words-ja": "^1.2.1",
    "textlint-rule-prh": "^6.1.1",
    "textlint-rule-sentence-length": "^5.2.1",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.27.0"
}
