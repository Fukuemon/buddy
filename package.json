{
  "name": "buddy",
  "private": true,
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "check:generated": "sh scripts/check-generated.sh",
    "check:screens": "node scripts/check-screens.mjs",
    "generate:db-docs": "sh scripts/build-db-docs.sh",
    "e2e": "pnpm --filter @buddy/e2e test",
    "site:build": "uv run zensical build --clean && pnpm --filter @buddy/web build-storybook && node scripts/build-docs-site.mjs && pnpm --filter @buddy/docs-site build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "textlint": "^15.8.0",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-preset-ai-words-ja": "^1.2.1",
    "textlint-rule-prh": "^6.1.1",
    "textlint-rule-sentence-length": "^5.2.1",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.27.0"
}
