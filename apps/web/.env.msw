# pnpm dev:msw が読む設定。ログインは compose の IdP と Valkey を使い、2 つの API は src/mocks/ のフェイクが受ける。
# 値は全て開発用のダミーで、ほかの環境で使わない。
VITE_API_MODE=bff
OIDC_ISSUER=http://localhost:9000/buddy
OIDC_CLIENT_ID=web
OIDC_CLIENT_SECRET=web-dev
SESSION_STORE_URL=redis://localhost:6379
SESSION_SECRET=buddy-dev-session-secret-for-msw-only
SESSION_COOKIE_SECURE=false
SCHEDULE_API_URL=http://schedule-api.mock
RECEIPT_API_URL=http://receipt-api.mock
